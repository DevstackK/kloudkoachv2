generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FeatureType {
  TimeBased
  CountBased
  TokenBased
}

enum SubscriptionStatus {
  active
  incomplete
  past_due
  canceled
}

enum CoachingSessionType {
  live_interview
  mock_interview
  exam_prep
  ai_interview
  pronunciation_practice
  virtual_patient
  meeting_helper
}

enum CoachingSessionStatus {
  in_progress
  completed
  abandoned
}

enum CreditTransactionReason {
  purchase
  session_usage
  manual_adjustment
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  stripeCustomerId String?  @unique
  resetToken      String?
  resetTokenExpiresAt DateTime?
  // Email OTP verification at signup. Stored in plaintext (not hashed, unlike
  // passwordHash) since it's a 6-digit code with a short TTL and a capped
  // attempt count below - the threat model is brute force within the
  // window, which otpAttempts stops, not credential reuse, which is what
  // hashing protects against.
  emailVerified   Boolean   @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 1 unit = 0.5 credit = 30 minutes of AI coaching. Stored in half-credit
  // units (not a Decimal credits column) so purchase/spend math is plain
  // integer arithmetic - see lib/credits.ts.
  creditBalanceUnits Int @default(0)

  subscriptions      Subscription[]
  resumes            Resume[]
  courseMaterial     CourseMaterial?
  coachingSessions   CoachingSession[]
  creditTransactions CreditTransaction[]
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  priceMonthly  Int      // cents
  stripePriceId String?
  priority      Int      @default(0) // higher = shown as "Popular"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  features      PlanFeature[]
  subscriptions Subscription[] @relation("PlanSubscriptions")
  scheduledFor  Subscription[] @relation("ScheduledPlanSubscriptions")
}

model PlanFeature {
  id          String      @id @default(cuid())
  planId      String
  featureCode String
  displayName String
  limitValue  Int         // -1 = unlimited
  unit        String
  featureType FeatureType
  isActive    Boolean     @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  scheduledPlanId      String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(active)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan  @relation("PlanSubscriptions", fields: [planId], references: [id])
  scheduledPlan Plan? @relation("ScheduledPlanSubscriptions", fields: [scheduledPlanId], references: [id])

  @@index([userId])
}

// One-time, non-expiring AI-minute top-ups - the pay-as-you-go alternative
// to a monthly Plan. Sold in whole credits (1 credit = 60 min) but spent in
// lib/credits.ts's 30-min units so partial sessions still bill fairly.
model CreditPack {
  id            String   @id @default(cuid())
  name          String
  credits       Int // whole credits sold, e.g. 3 / 8 / 15 (1 credit = 60 min)
  priceCents    Int
  stripePriceId String?
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// Ledger of every credit grant/spend - lets a balance be reconstructed and
// audited rather than trusting User.creditBalanceUnits alone.
model CreditTransaction {
  id                      String                   @id @default(cuid())
  userId                  String
  units                   Int // signed; 1 unit = 0.5 credit. + on purchase, - on session usage.
  reason                  CreditTransactionReason
  coachingSessionId       String?
  // Unique so a redelivered Stripe webhook event can't double-grant credits.
  stripeCheckoutSessionId String?                  @unique
  stripePaymentIntentId   String?
  createdAt               DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  rawText        String
  structuredData Json?
  fileName       String
  fileType       String
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  // Set only on AI-tailored variants (rewritten for a specific job
  // description) - null for plain uploads. Doubles as both the "is this
  // tailored" flag and the record of what it was tailored for.
  jobDescription String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CourseMaterial {
  userId    String   @id
  text      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachingSession {
  id              String                 @id @default(cuid())
  userId          String
  type            CoachingSessionType
  jobRole         String?
  jobDescription  String?
  status          CoachingSessionStatus  @default(in_progress)
  // "prose" | "bullets" - set once at session start, read by every
  // /api/coach/respond turn so the phone companion (which never picks this
  // itself) automatically inherits whatever the laptop chose.
  answerStyle     String                 @default("prose")
  startedAt       DateTime               @default(now())
  endedAt         DateTime?
  durationMinutes Int?
  averageScore    Float?

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions InteractionRecord[]

  @@index([userId])
}

model InteractionRecord {
  id               String   @id @default(cuid())
  sessionId        String
  questionText     String
  userAnswerText   String?
  suggestedAnswer  String?
  rating           Int?
  feedback         String?
  createdAt        DateTime @default(now())

  session CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

