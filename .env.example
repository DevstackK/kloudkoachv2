# Postgres (docker-compose service by default for local dev)
DATABASE_URL="postgresql://kloudkoach:kloudkoach@localhost:5432/kloudkoach?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Anthropic Claude API (backend answer generation)
ANTHROPIC_API_KEY=""

# Deepgram (live speech-to-text)
DEEPGRAM_API_KEY=""
DEEPGRAM_PROJECT_ID=""

# Stripe (billing) - after setting STRIPE_SECRET_KEY, run `npm run stripe:sync`
# to create Products/Prices for your Plan rows automatically.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
